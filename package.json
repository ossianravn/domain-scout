{
  "name": "domain-scout-plugin",
  "version": "0.4.1",
  "private": true,
  "license": "MIT",
  "description": "Suggests domain names for your project and checks them live with registries and registrars, including prices.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build",
    "test": "node --import tsx tests/acceptance.ts",
    "check": "npm run typecheck && npm test",
    "smoke": "node --import tsx scripts/live-smoke.ts",
    "start": "node dist/server.cjs",
    "inspect": "node dist/cli.cjs",
    "update:registry": "node --import tsx scripts/update-registry.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "tldts": "7.4.19",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@types/node": "^22.0.0",
    "esbuild": "0.28.2",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
