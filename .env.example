# Public registry and registrar sources require no API key.
# This optional .dk registrar adapter requires your existing account key.
# Set this in the environment of Codex or Claude. Files are not loaded implicitly.
SIMPLY_API_KEY=

# Operational defaults; provider-specific limits still apply.
DOMAIN_SCOUT_TIMEOUT_MS=8000
DOMAIN_SCOUT_CACHE_TTL_MS=60000
DOMAIN_SCOUT_MAX_WAIT_MS=10000

# Local pacing for generic WHOIS; not a claim about each registry's quota.
DOMAIN_SCOUT_WHOIS_INTERVAL_MS=1000

# Optional self-hosted Who-Dat fallback; disabled unless URL is set.
# See docs/who-dat.md. The public demo is for testing, not bulk queries.
DOMAIN_SCOUT_WHO_DAT_URL=
DOMAIN_SCOUT_WHO_DAT_TOKEN=
